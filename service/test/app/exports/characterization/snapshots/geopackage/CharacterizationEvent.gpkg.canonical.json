  "trigger:rtree_Locations_geometry_delete": "CREATE TRIGGER \"rtree_Locations_geometry_delete\" AFTER DELETE ON \"Locations\" WHEN old.geometry NOT NULL BEGIN  DELETE FROM \"rtree_Locations_geometry\" WHERE id = OLD.id; END",
  "trigger:rtree_Locations_geometry_insert": "CREATE TRIGGER \"rtree_Locations_geometry_insert\" AFTER INSERT ON \"Locations\" WHEN (new.geometry NOT NULL AND NOT ST_IsEmpty(NEW.geometry)) BEGIN   INSERT OR REPLACE INTO \"rtree_Locations_geometry\" VALUES (    NEW.id,    ST_MinX(NEW.geometry), ST_MaxX(NEW.geometry),     ST_MinY(NEW.geometry), ST_MaxY(NEW.geometry)   ); END",
  "trigger:rtree_Locations_geometry_update1": "CREATE TRIGGER \"rtree_Locations_geometry_update1\" AFTER UPDATE OF geometry ON \"Locations\" WHEN OLD.id = NEW.id AND      (NEW.geometry NOTNULL AND NOT ST_IsEmpty(NEW.geometry)) BEGIN   INSERT OR REPLACE INTO \"rtree_Locations_geometry\" VALUES (    NEW.id,    ST_MinX(NEW.geometry), ST_MaxX(NEW.geometry),     ST_MinY(NEW.geometry), ST_MaxY(NEW.geometry)   ); END",
  "trigger:rtree_Locations_geometry_update2": "CREATE TRIGGER \"rtree_Locations_geometry_update2\" AFTER UPDATE OF geometry ON \"Locations\" WHEN OLD.id = NEW.id AND        (NEW.geometry ISNULL OR ST_IsEmpty(NEW.geometry)) BEGIN   DELETE FROM \"rtree_Locations_geometry\" WHERE id = OLD.id; END",
  "trigger:rtree_Locations_geometry_update3": "CREATE TRIGGER \"rtree_Locations_geometry_update3\" AFTER UPDATE OF geometry ON \"Locations\" WHEN OLD.id != NEW.id AND        (NEW.geometry NOTNULL AND NOT ST_IsEmpty(NEW.geometry)) BEGIN   DELETE FROM \"rtree_Locations_geometry\" WHERE id = OLD.id;   INSERT OR REPLACE INTO \"rtree_Locations_geometry\" VALUES (    NEW.id,     ST_MinX(NEW.geometry), ST_MaxX(NEW.geometry),     ST_MinY(NEW.geometry), ST_MaxY(NEW.geometry)  ); END",
  "trigger:rtree_Locations_geometry_update4": "CREATE TRIGGER \"rtree_Locations_geometry_update4\" AFTER UPDATE ON \"Locations\"  WHEN OLD.id != NEW.id AND        (NEW.geometry ISNULL OR ST_IsEmpty(NEW.geometry)) BEGIN   DELETE FROM \"rtree_Locations_geometry\" WHERE id IN (OLD.id, NEW.id); END",
  "trigger:rtree_Observations_geometry_delete": "CREATE TRIGGER \"rtree_Observations_geometry_delete\" AFTER DELETE ON \"Observations\" WHEN old.geometry NOT NULL BEGIN  DELETE FROM \"rtree_Observations_geometry\" WHERE id = OLD.id; END",
  "trigger:rtree_Observations_geometry_insert": "CREATE TRIGGER \"rtree_Observations_geometry_insert\" AFTER INSERT ON \"Observations\" WHEN (new.geometry NOT NULL AND NOT ST_IsEmpty(NEW.geometry)) BEGIN   INSERT OR REPLACE INTO \"rtree_Observations_geometry\" VALUES (    NEW.id,    ST_MinX(NEW.geometry), ST_MaxX(NEW.geometry),     ST_MinY(NEW.geometry), ST_MaxY(NEW.geometry)   ); END",
  "trigger:rtree_Observations_geometry_update1": "CREATE TRIGGER \"rtree_Observations_geometry_update1\" AFTER UPDATE OF geometry ON \"Observations\" WHEN OLD.id = NEW.id AND      (NEW.geometry NOTNULL AND NOT ST_IsEmpty(NEW.geometry)) BEGIN   INSERT OR REPLACE INTO \"rtree_Observations_geometry\" VALUES (    NEW.id,    ST_MinX(NEW.geometry), ST_MaxX(NEW.geometry),     ST_MinY(NEW.geometry), ST_MaxY(NEW.geometry)   ); END",
  "trigger:rtree_Observations_geometry_update2": "CREATE TRIGGER \"rtree_Observations_geometry_update2\" AFTER UPDATE OF geometry ON \"Observations\" WHEN OLD.id = NEW.id AND        (NEW.geometry ISNULL OR ST_IsEmpty(NEW.geometry)) BEGIN   DELETE FROM \"rtree_Observations_geometry\" WHERE id = OLD.id; END",
  "trigger:rtree_Observations_geometry_update3": "CREATE TRIGGER \"rtree_Observations_geometry_update3\" AFTER UPDATE OF geometry ON \"Observations\" WHEN OLD.id != NEW.id AND        (NEW.geometry NOTNULL AND NOT ST_IsEmpty(NEW.geometry)) BEGIN   DELETE FROM \"rtree_Observations_geometry\" WHERE id = OLD.id;   INSERT OR REPLACE INTO \"rtree_Observations_geometry\" VALUES (    NEW.id,     ST_MinX(NEW.geometry), ST_MaxX(NEW.geometry),     ST_MinY(NEW.geometry), ST_MaxY(NEW.geometry)  ); END",
  "trigger:rtree_Observations_geometry_update4": "CREATE TRIGGER \"rtree_Observations_geometry_update4\" AFTER UPDATE ON \"Observations\"  WHEN OLD.id != NEW.id AND        (NEW.geometry ISNULL OR ST_IsEmpty(NEW.geometry)) BEGIN   DELETE FROM \"rtree_Observations_geometry\" WHERE id IN (OLD.id, NEW.id); END",
  "view:geometry_columns": "CREATE VIEW geometry_columns AS  SELECT    table_name AS f_table_name,    column_name AS f_geometry_column,    (CASE geometry_type_name       WHEN 'GEOMETRY' THEN 0       WHEN 'POINT' THEN 1       WHEN 'LINESTRING' THEN 2       WHEN 'POLYGON' THEN 3       WHEN 'MULTIPOINT' THEN 4       WHEN 'MULTILINESTRING' THEN 5       WHEN 'MULTIPOLYGON' THEN 6       WHEN 'GEOMETRYCOLLECTION' THEN 7       WHEN 'CIRCULARSTRING' THEN 8       WHEN 'COMPOUNDCURVE' THEN 9       WHEN 'CURVEPOLYGON' THEN 10       WHEN 'MULTICURVE' THEN 11       WHEN 'MULTISURFACE' THEN 12       WHEN 'CURVE' THEN 13       WHEN 'SURFACE' THEN 14       WHEN 'POLYHEDRALSURFACE' THEN 15       WHEN 'TIN' THEN 16       WHEN 'TRIANGLE' THEN 17       ELSE 0 END) AS geometry_type,    2 + (CASE z WHEN 1 THEN 1 WHEN 2 THEN 1 ELSE 0 END) + (CASE m WHEN 1 THEN 1 WHEN 2 THEN 1 ELSE 0 END) AS coord_dimension,    srs_id AS srid  FROM gpkg_geometry_columns",
  "view:spatial_ref_sys": "CREATE VIEW spatial_ref_sys AS SELECT   srs_id AS srid,   organization AS auth_name,   organization_coordsys_id AS auth_srid,   definition AS srtext FROM gpkg_spatial_ref_sys",
  "view:st_geometry_columns": "CREATE VIEW st_geometry_columns AS  SELECT    table_name,    column_name,    'ST_' || geometry_type_name AS geometry_type_name,    g.srs_id,    srs_name  FROM gpkg_geometry_columns as g JOIN gpkg_spatial_ref_sys AS s  WHERE g.srs_id = s.srs_id",
  "view:st_spatial_ref_sys": "CREATE VIEW st_spatial_ref_sys AS SELECT   srs_name,   srs_id,   organization,   organization_coordsys_id,   definition,   description FROM gpkg_spatial_ref_sys"
}
